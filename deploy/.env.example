############
# 비밀값 — 반드시 바꿀 것. sh scripts/gen-secrets.sh 로 생성한다.
############
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me
PG_META_CRYPTO_KEY=change-me-32-chars-min
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me

# 아직 안 씀 (Supabase 새 키 방식). 비워 두면 Envoy가 기존 방식으로 동작한다.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

############
# 주소
############
# 앱 주소. 로컬은 http://localhost:3000, 배포는 https://lunch.도메인
SITE_URL=http://localhost:3000
# Supabase API 게이트웨이 공개 주소. 앱 컨테이너와 브라우저 양쪽에서 닿아야 한다.
#   로컬: http://host.docker.internal:8000   (Docker Desktop이 호스트에 이 이름을 등록해 준다)
#   Tunnel 배포: https://lunch-api.도메인   (한 단계 서브도메인. api.lunch.도메인 은 무료 인증서 범위 밖)
#   Caddy 배포:  https://lunch.도메인       (앱과 같은 주소. Caddy가 /auth/v1, /rest/v1 경로만 api-gw 로 넘긴다)
SUPABASE_PUBLIC_URL=http://host.docker.internal:8000
API_EXTERNAL_URL=${SUPABASE_PUBLIC_URL}/auth/v1
# 로그인 후 돌아갈 수 있는 주소 목록(쉼표 구분). 앱의 /auth/callback 을 넣는다.
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/auth/callback

# 호스트에 여는 포트
APP_PORT=3000
API_GW_HTTP_PORT=8000

############
# 앱 환경변수 (Vercel에 넣어 둔 값과 같은 것)
############
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=
GOOGLE_MAPS_API_KEY=
PLACES_PROVIDER=kakao
ADMIN_EMAILS=
ROULETTE_ALLOW_ANY_TIME=

############
# 구글 로그인 (Google Cloud Console OAuth 클라이언트)
# 리디렉션 URI에 ${API_EXTERNAL_URL}/callback 을 등록해야 한다.
############
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

############
# 외부 공개 입구 (둘 중 하나만 씀)
############
# [기본] Cloudflare Tunnel (docker compose --profile tunnel). 대시보드에서 만든 터널 토큰.
CLOUDFLARE_TUNNEL_TOKEN=
# [대안] Caddy 직접 HTTPS (docker compose --profile public). 호스트명만, https:// 없이. 예: lunch.example.com
DOMAIN=

############
# Postgres
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Auth
############
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
# 메일은 안 쓰지만 GoTrue가 값을 요구한다.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=unused
SMTP_PASS=unused
SMTP_SENDER_NAME=unused

############
# PostgREST / Studio
############
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
STUDIO_DEFAULT_ORGANIZATION=lunch-roulette
STUDIO_DEFAULT_PROJECT=lunch-roulette
